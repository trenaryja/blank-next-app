{
	"name": "blank-next-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"chk": "rm -rf .next && bun check && bun fmt --check && eslint . --max-warnings=0 && bun run build",
		"dev": "next dev --turbo",
		"fix": "bun fmt && eslint --fix .",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install",
		"start": "next start"
	},
	"prettier": "@trenaryja/config/prettier",
	"dependencies": {
		"@t3-oss/env-nextjs": "^0.13.11",
		"@trenaryja/ui": "^0.0.1-37",
		"next": "^16.3.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@trenaryja/config": "^0.2.0",
		"@types/react": "^19.2.18",
		"daisyui": "^5.7.25",
		"tailwindcss": "^4.3.3"
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	},
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver"
	]
}
