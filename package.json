{
	"name": "blank-next-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "biome check --write .",
		"check": "tsc && biome check . && bun run build",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install"
	},
	"dependencies": {
		"@trenaryja/ui": "^0.0.1-0",
		"next": "^16",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@biomejs/biome": "^2",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^25",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"daisyui": "^5",
		"tailwindcss": "^4",
		"typescript": "^6"
	},
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver"
	],
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
