{
	"name": "blank-next-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"fix": "prettier -w . && eslint --fix .",
		"check": "rm -rf .next && tsc && prettier -c . && eslint . && bun run build",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install"
	},
	"dependencies": {
		"@t3-oss/env-nextjs": "^0.13.11",
		"@trenaryja/ui": "^0.0.1-37",
		"next": "^16.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@trenaryja/config": "^0.0.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"daisyui": "^5.7.17",
		"tailwindcss": "^4.3.3"
	},
	"prettier": "@trenaryja/config/prettier",
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver"
	],
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
